<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee 
         http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd"
         id="WebApp_ID" version="3.1">

    <display-name>Freelite</display-name>

    <!-- ========== 全局配置 ==========
         上传文件存储目录。
         Windows（Eclipse本地开发）：将 param-value 设为空字符串，自动使用 WEB-INF/uploads
         Linux/Docker（服务器部署）：设为 /home/admin/.openclaw/workspace/freelite-uploads
    -->
    <context-param>
        <param-name>uploadDir</param-name>
        <param-value></param-value>
    </context-param>

    <!-- 欢迎页 -->
    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

    <!-- ==================== A - 用户模块 ==================== -->
    <servlet>
        <servlet-name>RegisterServlet</servlet-name>
        <servlet-class>chen_yi_an.RegisterServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>RegisterServlet</servlet-name>
        <url-pattern>/register</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>LoginServlet</servlet-name>
        <servlet-class>chen_yi_an.LoginServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LoginServlet</servlet-name>
        <url-pattern>/login</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>LogoutServlet</servlet-name>
        <servlet-class>chen_yi_an.LogoutServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LogoutServlet</servlet-name>
        <url-pattern>/logout</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ProfileServlet</servlet-name>
        <servlet-class>chen_yi_an.ProfileServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ProfileServlet</servlet-name>
        <url-pattern>/profile/*</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>EditProfileServlet</servlet-name>
        <servlet-class>chen_yi_an.EditProfileServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>EditProfileServlet</servlet-name>
        <url-pattern>/profile/edit</url-pattern>
    </servlet-mapping>

    <!-- ==================== B - 项目模块 ==================== -->
    <servlet>
        <servlet-name>ProjectListServlet</servlet-name>
        <servlet-class>chen_kai_bo.ProjectListServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ProjectListServlet</servlet-name>
        <url-pattern>/projects</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>MyProjectsServlet</servlet-name>
        <servlet-class>chen_kai_bo.MyProjectsServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>MyProjectsServlet</servlet-name>
        <url-pattern>/my/projects</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>PostProjectServlet</servlet-name>
        <servlet-class>chen_kai_bo.PostProjectServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>PostProjectServlet</servlet-name>
        <url-pattern>/project/post</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ProjectDetailServlet</servlet-name>
        <servlet-class>chen_kai_bo.ProjectDetailServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ProjectDetailServlet</servlet-name>
        <url-pattern>/project/*</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>EditProjectServlet</servlet-name>
        <servlet-class>chen_kai_bo.EditProjectServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>EditProjectServlet</servlet-name>
        <url-pattern>/project/edit</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>DeleteProjectServlet</servlet-name>
        <servlet-class>chen_kai_bo.DeleteProjectServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>DeleteProjectServlet</servlet-name>
        <url-pattern>/project/delete</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>UpdateProjectStatusServlet</servlet-name>
        <servlet-class>chen_kai_bo.UpdateProjectStatusServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>UpdateProjectStatusServlet</servlet-name>
        <url-pattern>/project/status</url-pattern>
    </servlet-mapping>

    <!-- ==================== C - 竞标模块 ==================== -->
    <servlet>
        <servlet-name>PlaceBidServlet</servlet-name>
        <servlet-class>chen_xi_rui.PlaceBidServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>PlaceBidServlet</servlet-name>
        <url-pattern>/bid/place</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>BidListServlet</servlet-name>
        <servlet-class>chen_xi_rui.BidListServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>BidListServlet</servlet-name>
        <url-pattern>/bids/*</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>MyBidsServlet</servlet-name>
        <servlet-class>chen_xi_rui.MyBidsServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>MyBidsServlet</servlet-name>
        <url-pattern>/my/bids</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AwardBidServlet</servlet-name>
        <servlet-class>chen_xi_rui.AwardBidServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AwardBidServlet</servlet-name>
        <url-pattern>/bid/award</url-pattern>
    </servlet-mapping>

    <!-- ==================== D - 订单/评价/看板模块 ==================== -->
    <servlet>
        <servlet-name>OrderListServlet</servlet-name>
        <servlet-class>chen_zi_hao.OrderListServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>OrderListServlet</servlet-name>
        <url-pattern>/orders</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>OrderDetailServlet</servlet-name>
        <servlet-class>chen_zi_hao.OrderDetailServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>OrderDetailServlet</servlet-name>
        <url-pattern>/order/*</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>CompleteOrderServlet</servlet-name>
        <servlet-class>chen_zi_hao.CompleteOrderServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>CompleteOrderServlet</servlet-name>
        <url-pattern>/order/complete</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ReviewServlet</servlet-name>
        <servlet-class>chen_zi_hao.ReviewServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ReviewServlet</servlet-name>
        <url-pattern>/review</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>DashboardServlet</servlet-name>
        <servlet-class>chen_zi_hao.DashboardServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>DashboardServlet</servlet-name>
        <url-pattern>/dashboard</url-pattern>
    </servlet-mapping>

    <!-- ==================== E - 结算系统 ==================== -->
    <servlet>
        <servlet-name>WalletServlet</servlet-name>
        <servlet-class>chen_yi_an.WalletServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>WalletServlet</servlet-name>
        <url-pattern>/wallet</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>RechargeServlet</servlet-name>
        <servlet-class>chen_yi_an.RechargeServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>RechargeServlet</servlet-name>
        <url-pattern>/recharge</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ConfirmOrderServlet</servlet-name>
        <servlet-class>chen_zi_hao.ConfirmOrderServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ConfirmOrderServlet</servlet-name>
        <url-pattern>/order/confirm</url-pattern>
    </servlet-mapping>

    <!-- ==================== F - 交付与消息 ==================== -->
    <servlet>
        <servlet-name>DeliveryDownloadServlet</servlet-name>
        <servlet-class>chen_yi_an.DeliveryDownloadServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>DeliveryDownloadServlet</servlet-name>
        <url-pattern>/file/download</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>DeliveryChatServlet</servlet-name>
        <servlet-class>chen_yi_an.DeliveryChatServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>DeliveryChatServlet</servlet-name>
        <url-pattern>/deliveryChat</url-pattern>
    </servlet-mapping>

    <!-- ==================== 聊天弹窗 API ==================== -->
    <servlet>
        <servlet-name>MyChatProjectsServlet</servlet-name>
        <servlet-class>chen_yi_an.MyChatProjectsServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>MyChatProjectsServlet</servlet-name>
        <url-pattern>/api/myChatProjects</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ChatMessageApiServlet</servlet-name>
        <servlet-class>chen_yi_an.ChatMessageApiServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ChatMessageApiServlet</servlet-name>
        <url-pattern>/api/chatMessages</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ChatDeliveryApiServlet</servlet-name>
        <servlet-class>chen_yi_an.ChatDeliveryApiServlet</servlet-class>
        <multipart-config>
            <max-file-size>52428800</max-file-size>
            <max-request-size>104857600</max-request-size>
            <file-size-threshold>2097152</file-size-threshold>
        </multipart-config>
    </servlet>
    <servlet-mapping>
        <servlet-name>ChatDeliveryApiServlet</servlet-name>
        <url-pattern>/api/chatDelivery</url-pattern>
    </servlet-mapping>

    <!-- ==================== 切换角色 ==================== -->
    <servlet>
        <servlet-name>SwitchRoleServlet</servlet-name>
        <servlet-class>chen_yi_an.SwitchRoleServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>SwitchRoleServlet</servlet-name>
        <url-pattern>/profile/switchRole</url-pattern>
    </servlet-mapping>

    <!-- 登录认证过滤器 -->
    <filter>
        <filter-name>AuthFilter</filter-name>
        <filter-class>com.freelite.filter.AuthFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <!-- 字符编码过滤器 -->
    <filter>
        <filter-name>EncodingFilter</filter-name>
        <filter-class>org.apache.catalina.filters.SetCharacterEncodingFilter</filter-class>
        <init-param>
            <param-name>encoding</param-name>
            <param-value>UTF-8</param-value>
        </init-param>
    </filter>
    <filter-mapping>
        <filter-name>EncodingFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

</web-app>
